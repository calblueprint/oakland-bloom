NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback for existing deployments; optional when publishable key is set.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Development-only PostgreSQL connection string for pnpm seed:reservations.
# Copy the direct/session connection from Supabase Connect; never use NEXT_PUBLIC_.
SEED_DATABASE_URL=

# Optional CA file override (absolute path or relative to repository root).
# Supabase database hosts use scripts/certs/supabase-prod-ca-2021.crt by default.
SEED_DATABASE_CA_FILE=

# Optional live-test settings. Keep actual credentials only in .env.local.
RESERVATION_TEST_EMAIL=
RESERVATION_TEST_PASSWORD=
RESERVATION_TEST_USER_ID=
# Start Next.js with RESERVATION_LIVE_TEST_ENABLED=1 only for local integration tests.
# RESERVATION_TEST_APP_URL=http://127.0.0.1:3000

# Second dedicated login for live two-chef isolation testing.
RESERVATION_TEST_USER2_EMAIL=
RESERVATION_TEST_USER2_PASSWORD=
RESERVATION_TEST_USER2_ID=
